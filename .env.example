# DYNAFOLD Hub — Example environment variables
# Copy to .env and fill in your values. NEVER commit .env to git.

# ─────────────────────────────────────────────
# Model API Keys
# ─────────────────────────────────────────────

# AlphaFold Server (DeepMind)
# Get yours at: https://alphafoldserver.com
ALPHAFOLD_SERVER_API_KEY=

# EvolutionaryScale (ESM3 hosted API)
# Get yours at: https://evolutionaryscale.ai
EVOLUTIONARYSCALE_API_KEY=

# ─────────────────────────────────────────────
# Local Model Settings
# ─────────────────────────────────────────────

# Chai-1 settings
CHAI1_DEVICE=auto      # auto | cpu | cuda | mps
CHAI1_CACHE_DIR=       # default: ~/.cache/dynafold_hub/chai1

# Boltz-2 settings
BOLTZ2_DEVICE=auto

# ─────────────────────────────────────────────
# Application Settings (Phase 2+)
# ─────────────────────────────────────────────

# Database (Postgres)
DATABASE_URL=postgresql://user:pass@localhost:5432/dynafold

# Storage (S3-compatible)
S3_ENDPOINT=
S3_BUCKET=dynafold-hub
S3_ACCESS_KEY=
S3_SECRET_KEY=

# Redis (for async tasks)
REDIS_URL=redis://localhost:6379/0

# Auth
SESSION_SECRET=

# Analytics
PLAUSIBLE_DOMAIN=dynafold.io

# Error tracking
SENTRY_DSN=
